GEMINI_API_KEY=replace_me
GEMINI_VISION_MODEL=gemini-3.6-flash
PORT=8787
CORS_ORIGINS=https://2flykl.github.io,http://localhost:5173
# Optional Gemini Vision resilience overrides
GEMINI_VISION_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_MS=850
GEMINI_RETRY_MAX_MS=7000
GEMINI_REQUEST_TIMEOUT_MS=55000

# Local Real-ESRGAN Upscale Beast (zero API usage)
# Leave unset to use the default repo-relative location:
# ..\tools\realesrgan\realesrgan-ncnn-vulkan.exe
REALESRGAN_PATH=C:\Users\YOUR_USER\Documents\GitHub\XPLAY\XPLAYEngine\tools\realesrgan\realesrgan-ncnn-vulkan.exe
REALESRGAN_MODEL=realesrgan-x4plus
