# The server searches upward for server/.env too, so your existing XPLAY key may already be found.
OPENAI_API_KEY=replace_me
OPENAI_IMAGE_MODEL=gpt-image-1
PORT=8832

# Economy defaults. Change only if you want higher-cost generations.
CUTOUT_IMAGE_QUALITY=medium
CUTOUT_POSE_SIZE=1024x1024
CUTOUT_STAGE_SIZE=1536x1024

# Optional local Real-ESRGAN executable. Leave blank to disable.
REALESRGAN_PATH=
