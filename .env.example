PORT=8787
VISION_SERVICE_URL=http://127.0.0.1:8790
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini Vision resilience (optional overrides)
# Primary model remains GEMINI_VISION_MODEL. On transient 408/429/5xx errors,
# XPLAY retries with exponential backoff and then moves through this fallback list.
GEMINI_VISION_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_MS=850
GEMINI_RETRY_MAX_MS=7000
GEMINI_REQUEST_TIMEOUT_MS=55000
